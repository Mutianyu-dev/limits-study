        { "key": "B", "text": "$1$" },
        { "key": "C", "text": "$e$" },
        { "key": "D", "text": "不存在" }
      ],
      "answer": "B",
      "explanation": "$0^{0}$ 型，取对数得 $x\\ln x\\to 0$，故原式 $=e^{0}=1$。"
