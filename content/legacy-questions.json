  "questions": [
    {
      "id": "q001",
      "type": "concept",
      "difficulty": "easy",
      "stem": "极限 $\\lim_{x\\to 0}\\sin(1/x)$ 的结果是？",
      "options": [
        { "key": "A", "text": "$0$" },
        { "key": "B", "text": "$1$" },
        { "key": "C", "text": "不存在" },
        { "key": "D", "text": "$\\infty$" }
      ],
      "answer": "C",
      "explanation": "取 $x_n=\\frac{1}{n\\pi}$，得 $\\sin\\frac{1}{x_n}=0$；取 $x_n=\\frac{1}{2n\\pi+\\frac{\\pi}{2}}$，得 $\\sin\\frac{1}{x_n}=1$。两条子列极限不同，由归结原则，原极限不存在。"
    },
    {
      "id": "q002",
      "type": "concept",
      "difficulty": "easy",
      "stem": "函数 $f(x)=\\dfrac{\\sin x}{x}$ 在 $x=0$ 处属于？",
      "options": [
        { "key": "A", "text": "连续点" },
        { "key": "B", "text": "可去间断点" },
        { "key": "C", "text": "跳跃间断点" },
        { "key": "D", "text": "无穷间断点" }
      ],
      "answer": "B",
      "explanation": "$\\lim_{x\\to 0}\\frac{\\sin x}{x}=1$ 存在，但 $f(0)$ 无定义。补上 $f(0)=1$ 即可连续，故为可去间断点。"
    },
    {
      "id": "q003",
      "type": "concept",
      "difficulty": "easy",
      "stem": "$\\lim_{x\\to 0}(1+x)^{1/x}=$",
      "options": [
        { "key": "A", "text": "$1$" },
        { "key": "B", "text": "$e$" },
        { "key": "C", "text": "$e^{2}$" },
        { "key": "D", "text": "$\\infty$" }
      ],
      "answer": "B",
      "explanation": "这是第二个重要极限的标准形式，属于 $1^{\\infty}$ 型，值为 $e$。"
    },
    {
      "id": "q004",
      "type": "concept",
      "difficulty": "medium",
      "stem": "设 $\\lim f(x)=A$，$\\lim g(x)=B$，要使 $\\lim\\dfrac{f(x)}{g(x)}=\\dfrac{A}{B}$ 成立，还需补充的条件是？",
      "options": [
        { "key": "A", "text": "$A\\neq 0$" },
        { "key": "B", "text": "$B\\neq 0$" },
        { "key": "C", "text": "$B=0$" },
        { "key": "D", "text": "$A=B$" }
      ],
      "answer": "B",
      "explanation": "商的极限法则要求分母的极限不为零。若 $B=0$，需要另行判断是 $\\frac{0}{0}$、$\\frac{A}{0}$ 还是不存在。"
    },
    {
      "id": "q005",
      "type": "form00",
      "difficulty": "easy",
      "stem": "$\\lim_{x\\to 0}\\dfrac{\\sin 3x}{x}=$",
      "options": [
        { "key": "A", "text": "$0$" },
        { "key": "B", "text": "$\\frac{1}{3}$" },
        { "key": "C", "text": "$3$" },
        { "key": "D", "text": "$9$" }
      ],
      "answer": "C",
      "explanation": "由 $\\sin 3x\\sim 3x$，或写成 $3\\cdot\\frac{\\sin 3x}{3x}$，极限为 $3$。"
    },
    {
      "id": "q006",
      "type": "form00",
      "difficulty": "easy",
      "stem": "$\\lim_{x\\to 0}\\dfrac{1-\\cos x}{x^{2}}=$",
      "options": [
        { "key": "A", "text": "$0$" },
        { "key": "B", "text": "$\\frac{1}{2}$" },
        { "key": "C", "text": "$1$" },
        { "key": "D", "text": "$2$" }
      ],
      "answer": "B",
      "explanation": "由 $1-\\cos x\\sim\\frac{x^{2}}{2}$ 直接得 $\\frac{1}{2}$。"
    },
    {
      "id": "q007",
      "type": "form00",
      "difficulty": "medium",
      "stem": "$\\lim_{x\\to 0}\\dfrac{\\sqrt{1+x}-1}{x}=$",
      "options": [
        { "key": "A", "text": "$0$" },
        { "key": "B", "text": "$\\frac{1}{2}$" },
        { "key": "C", "text": "$1$" },
        { "key": "D", "text": "$2$" }
      ],
      "answer": "B",
      "explanation": "有理化：分子分母同乘 $\\sqrt{1+x}+1$，得 $\\frac{1}{\\sqrt{1+x}+1}\\to\\frac{1}{2}$；也可用 $\\sqrt{1+x}-1\\sim\\frac{x}{2}$。"
    },
    {
      "id": "q008",
      "type": "form00",
      "difficulty": "medium",
      "stem": "$\\lim_{x\\to 0}\\dfrac{x-\\sin x}{x^{3}}=$",
      "options": [
        { "key": "A", "text": "$0$" },
        { "key": "B", "text": "$\\frac{1}{6}$" },
        { "key": "C", "text": "$\\frac{1}{3}$" },
        { "key": "D", "text": "$1$" }
      ],
      "answer": "B",
      "explanation": "$\\sin x=x-\\frac{x^{3}}{6}+o(x^{3})$，故 $x-\\sin x=\\frac{x^{3}}{6}+o(x^{3})$，极限为 $\\frac{1}{6}$。"
    },
    {
      "id": "q009",
      "type": "form00",
      "difficulty": "medium",
      "stem": "$\\lim_{x\\to 0}\\dfrac{\\tan x-\\sin x}{x^{3}}=$",
      "options": [
        { "key": "A", "text": "$0$" },
        { "key": "B", "text": "$\\frac{1}{6}$" },
        { "key": "C", "text": "$\\frac{1}{2}$" },
        { "key": "D", "text": "$1$" }
      ],
      "answer": "C",
      "explanation": "不能把 $\\tan x$、$\\sin x$ 各自换成 $x$（会得 $0$）。展开：$\\tan x=x+\\frac{x^{3}}{3}$，$\\sin x=x-\\frac{x^{3}}{6}$，差为 $\\frac{x^{3}}{2}$，极限 $\\frac{1}{2}$。"
    },
    {
      "id": "q010",
      "type": "form00",
      "difficulty": "hard",
      "stem": "$\\lim_{x\\to 0}\\dfrac{e^{x}-1-x}{x^{2}}=$",
      "options": [
        { "key": "A", "text": "$0$" },
        { "key": "B", "text": "$\\frac{1}{2}$" },
        { "key": "C", "text": "$1$" },
        { "key": "D", "text": "$e$" }
      ],
      "answer": "B",
      "explanation": "$e^{x}=1+x+\\frac{x^{2}}{2}+o(x^{2})$，故分子 $=\\frac{x^{2}}{2}+o(x^{2})$，极限 $\\frac{1}{2}$。"
    },
    {
      "id": "q011",
      "type": "form00",
      "difficulty": "hard",
      "stem": "$\\lim_{x\\to 0}\\dfrac{\\ln(1+x)-x}{x^{2}}=$",
      "options": [
        { "key": "A", "text": "$-\\frac{1}{2}$" },
        { "key": "B", "text": "$0$" },
        { "key": "C", "text": "$\\frac{1}{2}$" },
        { "key": "D", "text": "$1$" }
      ],
      "answer": "A",
      "explanation": "$\\ln(1+x)=x-\\frac{x^{2}}{2}+o(x^{2})$，故分子 $=-\\frac{x^{2}}{2}+o(x^{2})$，极限 $-\\frac{1}{2}$。"
    },
    {
      "id": "q012",
      "type": "forminf",
      "difficulty": "easy",
      "stem": "$\\lim_{x\\to\\infty}\\dfrac{3x^{2}+2x}{2x^{2}-1}=$",
      "options": [
        { "key": "A", "text": "$0$" },
        { "key": "B", "text": "$\\frac{3}{2}$" },
        { "key": "C", "text": "$2$" },
        { "key": "D", "text": "$\\infty$" }
      ],
      "answer": "B",
      "explanation": "同次多项式之比等于最高次项系数之比：$\\frac{3}{2}$。"
    },
    {
      "id": "q013",
      "type": "forminf",
      "difficulty": "easy",
      "stem": "$\\lim_{x\\to\\infty}\\dfrac{x^{3}+2x}{x^{2}+1}=$",
      "options": [
        { "key": "A", "text": "$1$" },
        { "key": "B", "text": "$2$" },
        { "key": "C", "text": "$\\infty$" },
        { "key": "D", "text": "$0$" }
      ],
      "answer": "C",
      "explanation": "分子次数高于分母，同除 $x^{2}$ 后分子含 $x$ 项，故趋于 $\\infty$。"
    },
    {
      "id": "q014",
      "type": "forminf",
      "difficulty": "medium",
      "stem": "$\\lim_{x\\to\\infty}\\dfrac{2x+\\sin x}{x}=$",
