    },
    {
      "id": "q030",
      "type": "sequence",
      "difficulty": "hard",
      "stem": "$\\lim_{n\\to\\infty}\\left(\\dfrac{1}{n+1}+\\dfrac{1}{n+2}+\\cdots+\\dfrac{1}{n+n}\\right)=$",
