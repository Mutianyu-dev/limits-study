        { "key": "A", "text": "$1$" },
        { "key": "B", "text": "$e$" },
        { "key": "C", "text": "$e^{2}$" },
        { "key": "D", "text": "$\\infty$" }
      ],
      "answer": "B",
      "explanation": "第二个重要极限。用公式：$v(u-1)=n\\cdot\\frac{1}{n}=1$，故为 $e$。"
    },
    {
      "id": "q024",
      "type": "formpower",
      "difficulty": "medium",
      "stem": "$\\lim_{x\\to\\infty}x^{1/x}=$",
