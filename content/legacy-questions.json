        { "key": "A", "text": "$0$" },
        { "key": "B", "text": "$\\frac{1}{2}$" },
        { "key": "C", "text": "$1$" },
        { "key": "D", "text": "$\\infty$" }
      ],
      "answer": "B",
      "explanation": "通分得 $\\frac{e^{x}-1-x}{x(e^{x}-1)}$；分母 $\\sim x^{2}$，分子 $\\sim\\frac{x^{2}}{2}$，极限 $\\frac{1}{2}$。"
    },
    {
      "id": "q020",
      "type": "formdiff",
      "difficulty": "medium",
      "stem": "$\\lim_{x\\to\\infty}\\left(\\sqrt{x^{2}+x}-x\\right)=$",
