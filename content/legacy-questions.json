    },
    {
      "id": "q019",
      "type": "formdiff",
      "difficulty": "easy",
      "stem": "$\\lim_{x\\to 0}\\left(\\dfrac{1}{x}-\\dfrac{1}{e^{x}-1}\\right)=$",
