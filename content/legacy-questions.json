        { "key": "A", "text": "$0$" },
        { "key": "B", "text": "$\\frac{1}{2}$" },
        { "key": "C", "text": "$1$" },
        { "key": "D", "text": "$\\infty$" }
      ],
      "answer": "B",
      "explanation": "有理化得 $\\frac{x}{\\sqrt{x^{2}+x}+x}\\to\\frac{1}{2}$。"
