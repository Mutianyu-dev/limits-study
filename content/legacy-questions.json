    {
      "id": "q029",
      "type": "sequence",
      "difficulty": "medium",
      "stem": "$\\lim_{n\\to\\infty}\\dfrac{1+\\frac{1}{2}+\\cdots+\\frac{1}{n}}{\\ln n}=$",
