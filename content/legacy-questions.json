    {
      "id": "q021",
      "type": "formdiff",
      "difficulty": "hard",
      "stem": "$\\lim_{x\\to 0}\\left(\\dfrac{1}{x^{2}}-\\dfrac{1}{\\sin^{2}x}\\right)=$",
